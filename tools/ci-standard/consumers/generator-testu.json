    }
  ],
  "gates": [
    {
      "role": "candidate",
      "workflow": ".github/workflows/safe-promotion.yml",
      "job": "candidate-gate",
      "checkName": "candidate-gate",
      "identity": "candidate-source",
      "independentGroup": "candidate"
    },
    {
      "role": "pr",
      "workflow": ".github/workflows/safe-promotion.yml",
      "job": "pr-certification",
      "checkName": "pr-certification",
      "identity": "candidate-source",
      "independentGroup": "pr"
    },
    {
      "role": "p5",
      "workflow": ".github/workflows/p5-release-gate.yml",
      "job": "p5-release-gate",
      "checkName": "p5-release-gate",
      "identity": "candidate-source",
      "independentGroup": "p5"
    },
    {
      "role": "journey",
      "workflow": ".github/workflows/journey-e2e.yml",
      "job": "journey-e2e",
      "checkName": "journey-e2e",
      "identity": "candidate-source",
      "independentGroup": "journey"
    },
    {
      "role": "admission",
      "workflow": ".github/workflows/safe-promotion.yml",
      "job": "admission",
      "checkName": "release-admission",
      "identity": "candidate-source",
      "independentGroup": null
