    "npmLockfile": "package-lock.json",
    "playwright": "1.61.1",
    "axe": "4.12.1",
    "pythonRequirements": "audit/requirements-audit.txt"
  },
  "trustInputs": [
    {
      "environment": "GARP27_EXTERNAL_TRUST_SHA256",
