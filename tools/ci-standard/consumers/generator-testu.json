  "invariants": [
    "exact-source-identity",
    "independent-certifications",
    "fail-closed-admission",
    "branch-and-pr-freshness",
    "retain-mandatory-gates",
    "preserve-evidence-before-cleanup",
    "pinned-dependencies",
    "least-privilege",
    "atomic-candidate-update",
    "protected-production-deploy",
    "verify-live-release-identity",
    "repository-specific-trust"
  ],
  "sharing": {
    "implementation": true,
    "buildArtifact": false,
    "certificationResult": false
  }
