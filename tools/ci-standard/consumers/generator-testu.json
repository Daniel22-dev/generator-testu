{
  "schema": "ghrab-ci-consumer-v1",
  "standardVersion": "1.0.0",
  "purpose": "DIAGNOSTIC_ONLY_NOT_RELEASE_ADMISSION",
  "repository": "Daniel22-dev/generator-testu",
  "repositoryId": "1262251614",
  "appId": "generator-testu",
  "profile": "git-independent-v1",
