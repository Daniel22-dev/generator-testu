{
  "schema": "ghrab-data-manifest-v1",
  "appId": "generator",
  "appVersion": "7.1.20",
  "manifestVersion": 3,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true,
    "differentiationAiEgress": "structured identities and identifiers known from each group roster are replaced by Student A1/A2-style pseudonyms; free text also carries a UI warning because unknown names cannot be reliably detected"
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-data",
      "patterns": [
        "ghrab.generator.*",
        "sestavovac_*",
        "genOnboardingDone_v1"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true,
      "note": "GHRAB Platform aliases legacy sestavovac_* keys to canonical ghrab.generator.* keys after migration."
    },
    {
      "kind": "sessionStorage",
      "category": "session-data",
      "patterns": [
        "ghrab.generator.ai.key.session.v1",
        "ghrab.generator.ai.data-notice.v1",
        "ghrab.generator.welcome-shown.v1",
        "sestavovac_*",
        "genWelcomeShown_session"
      ],
      "sensitivity": "confidential",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "credential",
      "patterns": [
        "ghrab.generator.ai.key.local.v1",
        "sestavovac_gemini_key",
        "ghrab.generator.security-code.v1",
        "sestavovac_school_security_code_v1"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ghrab.generator.ai.key.session.v1",
        "sestavovac_gemini_key_session"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "manual-preferences",
      "patterns": [
        "ghrab-manual-progress-test-generator-*",
        "ghrab-manual-theme"
      ],
      "sensitivity": "non-personal-settings",
      "authority": "manual-page",
      "clearOnEndWork": false,
      "note": "Manual progress/theme are not student-content stores and are outside Generator scoped end-work cleanup."
    },
    {
      "kind": "localStorage",
      "category": "shared-platform-handoff-telemetry",
      "patterns": [
        "ghrab.handoff.v1",
        "ghrab.pilot.events.v2",
        "ghrab.access.permit.v2"
      ],
      "sensitivity": "mixed-shared-platform",
      "authority": "AI-Studio/shared-platform",
      "clearOnEndWork": "permit-only",
      "note": "Legacy handoff is removed when consumed/expired. Pilot events contain handoff metadata, not material content. The shared access permit is removed by generatorEndWork()."
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-generator-v*",
        "generator*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    }
  ],
  "retention": {
    "defaultDays": null,
    "clientPolicy": "until-explicit-end-work-or-browser-site-data-clearing",
    "sessionEndsOnLogout": true,
    "serverLogsDays": null,
    "note": "Current GitHub/serverless profile has no app server retention job. School-server retention is a deployment policy and must be re-verified when connected."
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [],
    "nativeFormats": [
      "csv",
      "html",
      "json",
      "pdf",
      "zip"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "clientControl": "generatorEndWork()",
    "serverEndpoint": null,
    "scope": "generator-owned localStorage/sessionStorage plus central access permit and current-page in-memory Generator test/file/roster state; excludes other AI Studio app data and non-content PWA cache"
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "generatorEndWork()"
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.generator.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "full",
    "rollbackSupported": true
  },
  "import": {
    "supported": true,
    "artifactTypes": [
      "generator-testu-zadani"
    ],
    "nativeFormats": [
      "json"
    ],
    "acceptsLegacyJson": false,
    "checksumRequiredForEnvelope": true,
    "maxBytes": 524288,
    "validation": "exact __type/formatVersion plus allowlisted state/DOM sanitization; uploaded binary source files are not embedded in this transfer format",
    "note": "This describes the teacher-to-teacher assignment-configuration JSON import. Other generated HTML/ZIP/result exports are not reimported through this path."
  }
}
